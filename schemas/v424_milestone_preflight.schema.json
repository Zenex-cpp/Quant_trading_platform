{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V4.24 Milestone Compliance Preflight Input Contract",
  "type": "object",
  "required": ["decision_id", "milestone_id", "baseline_version", "baseline_sha256", "impacted_ids", "input_hashes"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "milestone_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "minLength": 1},
    "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "impacted_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "additionalProperties": false
}
