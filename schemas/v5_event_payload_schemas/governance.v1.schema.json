{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-trading-platform.invalid/schemas/governance-event-payload/v1",
  "title": "Governance Event Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "sequence", "event_type", "actor", "model_id", "previous_model_id", "reason", "risk_before", "risk_after", "timestamp_ns", "previous_hash", "event_hash"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["PROMOTION", "DEMOTION", "QUARANTINE", "ROLLBACK", "APPROVAL_REVOKED"]},
    "actor": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "previous_model_id": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "risk_before": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"},
    "risk_after": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "previous_hash": {"type": "string", "pattern": "^(GENESIS|[0-9a-f]{64})$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
