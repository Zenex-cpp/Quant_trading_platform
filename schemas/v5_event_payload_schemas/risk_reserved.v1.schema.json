{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable risk reservation payload v1",
  "type": "object",
  "properties": {
    "reservation_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["SYSTEM", "PORTFOLIO", "STRATEGY", "MODEL", "TRADE", "ORDER"]},
    "requested": {"type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"},
    "allowed": {"type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"},
    "intent_id": {"type": "string", "minLength": 1},
    "risk_decision_id": {"type": "string", "minLength": 1},
    "accounting_projection_hash": {"type": "string", "minLength": 1},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "expires_at_ms": {"type": ["integer", "null"], "minimum": 0}
  },
  "required": ["reservation_id", "scope", "requested", "allowed", "intent_id", "risk_decision_id", "accounting_projection_hash", "created_at_ms", "expires_at_ms"],
  "additionalProperties": false
}
