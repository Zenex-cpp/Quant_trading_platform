{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production credential resolution payload v1",
  "type": "object",
  "properties": {
    "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "actor_role": {"enum": ["RESEARCH", "TRAINING", "BACKTEST", "SHADOW", "CANARY", "PRODUCTION_TRADING", "DEPLOYMENT", "CONFIGURATION", "SECURITY_ADMIN", "UNKNOWN"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"},
    "authorization_decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"}
  },
  "required": ["credential_id", "version", "actor_role", "fingerprint"],
  "dependentRequired": {"actor_id": ["authorization_decision_id"], "authorization_decision_id": ["actor_id"]},
  "additionalProperties": false
}
