{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy production credential registration payload v0.9",
  "type": "object",
  "properties": {
    "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "valid_from_ms": {"type": "integer", "minimum": 0},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "ACTIVE"}
  },
  "required": ["credential_id", "version", "valid_from_ms", "expires_at_ms", "fingerprint", "status"],
  "additionalProperties": false
}
